<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Versioning -->
    <Version>1.0.0-rc.1</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>

    <!-- Package Metadata -->
    <PackageId>Vectis.Fiskaly.SDK</PackageId>
    <Title>Vectis Fiskaly SDK</Title>
    <Description>.NET SDK for Fiskaly SIGN DE v2 API - German fiscal compliance (KassenSichV)</Description>
    <Authors>Anatoliy Yermakov</Authors>
    <Company>Vectis Open Source Community</Company>
    <PackageProjectUrl>https://github.com/i7aket/Vectis.Fiskaly.SDK</PackageProjectUrl>
    <RepositoryUrl>https://github.com/i7aket/Vectis.Fiskaly.SDK.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageTags>fiskaly;sign-de;kassensichv;dotnet;sdk;pos</PackageTags>
    <PackageReleaseNotes>
Release candidate for the first public NuGet publication.

Highlights:
- cleaned public documentation
- removed embedded integration credentials
- prepared repository for public open-source distribution
    </PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Vectis.Fiskaly.IntegrationTests" />
    <InternalsVisibleTo Include="Vectis.Fiskaly.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.WebUtilities" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.2.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.2" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
